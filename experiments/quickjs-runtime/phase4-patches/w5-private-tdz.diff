+
+// w5: QuickJS reads private element slots with unchecked get_loc/get_var_ref.
+// A slot is still in its TDZ when the read runs before the element definition
+// (a computed key of the same class). The generic get case turns a TDZ cell
+// into status 5 (guest ReferenceError) before privateNameOrAbsent can see it,
+// so packProgram flags such loads (b=1) and the get case pushes the TDZ cell
+// for the private opcode to answer (TypeError / false). Requires
+// w5-private-in-setter-only.diff: without it a setter-only `#x in o` reads a
+// TDZ cell forever and would answer false.
+export const privateSlotConsumers = Object.freeze(['private_in', 'get_private_field', 'put_private_field', 'check_brand']);
+export function privateSlotLoad(instructions, index) {
+  const next = instructions.slice(index + 1, index + 4).map(i => i.op);
+  // obj value <load #x<set>> swap rot3r check_brand: private setter write.
+  return privateSlotConsumers.includes(next[0]) || (next[0] === 'swap' && next[1] === 'rot3r' && next[2] === 'check_brand');
+}
